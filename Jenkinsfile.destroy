pipeline {
    agent any
    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }
        stage('Terraform Init') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'aws_creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                    sh "terraform init > init.txt"
                    sh "cat init.txt"
                }
            }
        }
        stage('Terraform Takedown') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'aws_creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                     // This targets the state file in Jenkins and deletes the AWS infra
                    sh 'terraform destroy -auto-approve >destroy.txt'
                    sh "cat destroy.txt"
                }
            }
        }
               
    }
}